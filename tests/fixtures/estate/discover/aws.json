{
  "about": "What the aws CLI answers for a small account in eu-west-1: a web tier behind a load balancer, a database, a bucket, the region's default VPC (unused), and one call the account may not make. Keys are the call without --output, --profile and the program name.",
  "calls": {
    "sts get-caller-identity": {"Account": "111122223333", "Arn": "arn:aws:iam::111122223333:user/reader", "UserId": "AIDA"},
    "ec2 describe-vpcs --region eu-west-1": {"Vpcs": [
      {"VpcId": "vpc-0a1", "CidrBlock": "10.10.0.0/16", "IsDefault": false, "Tags": [{"Key": "Name", "Value": "shop-prod"}]},
      {"VpcId": "vpc-0de", "CidrBlock": "172.31.0.0/16", "IsDefault": true}
    ]},
    "ec2 describe-subnets --region eu-west-1": {"Subnets": [
      {"SubnetId": "subnet-pub-a", "VpcId": "vpc-0a1", "CidrBlock": "10.10.0.0/24", "AvailabilityZone": "eu-west-1a", "MapPublicIpOnLaunch": false, "DefaultForAz": false, "Tags": [{"Key": "Name", "Value": "shop-prod-public-a"}]},
      {"SubnetId": "subnet-pub-b", "VpcId": "vpc-0a1", "CidrBlock": "10.10.1.0/24", "AvailabilityZone": "eu-west-1b", "MapPublicIpOnLaunch": false, "DefaultForAz": false, "Tags": [{"Key": "Name", "Value": "shop-prod-public-b"}]},
      {"SubnetId": "subnet-app-a", "VpcId": "vpc-0a1", "CidrBlock": "10.10.10.0/24", "AvailabilityZone": "eu-west-1a", "MapPublicIpOnLaunch": false, "DefaultForAz": false, "Tags": [{"Key": "Name", "Value": "shop-prod-app-a"}]},
      {"SubnetId": "subnet-app-b", "VpcId": "vpc-0a1", "CidrBlock": "10.10.11.0/24", "AvailabilityZone": "eu-west-1b", "MapPublicIpOnLaunch": false, "DefaultForAz": false, "Tags": [{"Key": "Name", "Value": "shop-prod-app-b"}]},
      {"SubnetId": "subnet-def-a", "VpcId": "vpc-0de", "CidrBlock": "172.31.0.0/20", "AvailabilityZone": "eu-west-1a", "MapPublicIpOnLaunch": true, "DefaultForAz": true}
    ]},
    "ec2 describe-internet-gateways --region eu-west-1": {"InternetGateways": [
      {"InternetGatewayId": "igw-0a1", "Attachments": [{"VpcId": "vpc-0a1", "State": "available"}], "Tags": [{"Key": "Name", "Value": "shop-prod-igw"}]}
    ]},
    "ec2 describe-nat-gateways --region eu-west-1": {"NatGateways": [
