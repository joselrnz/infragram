      {"id": "/subscriptions/00000000-0000-0000-0000-000000000001/resourceGroups/rg-app/providers/Microsoft.Network/virtualNetworks/vnet-app", "name": "vnet-app", "location": "westeurope", "resourceGroup": "rg-app",
